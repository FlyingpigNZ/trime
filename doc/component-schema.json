{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trime.osfans.app/schemas/component-manifest.schema.json",
  "title": "Trime Component Manifest",
  "description": "A concrete input method / theme described as a composition of reusable components.",
  "type": "object",
  "required": ["name", "components"],
  "properties": {
    "name": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "schema_id": { "type": "string" },
    "schema_file": { "type": "string" },
    "layout_files": { "type": "array", "items": { "type": "string" } },
    "default_keyboard": { "type": "string" },
    "resources": { "type": "array", "items": { "type": "string" } },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/componentEntry" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "componentEntry": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/componentMapping" }
      ]
    },
    "componentMapping": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "schema": {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": { "type": "string" }
          },
          "additionalProperties": false
        },
        "keyboard": { "$ref": "#/$defs/operationSpec" },
        "behavior": { "$ref": "#/$defs/operationSpec" },
        "color": { "$ref": "#/$defs/operationSpec" },
        "style": { "$ref": "#/$defs/styleSpec" },
        "resources": { "$ref": "#/$defs/operationSpec" }
      },
      "additionalProperties": false
    },
    "operationSpec": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "add": { "type": "object" },
        "override": { "type": "object" },
        "remove": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "styleSpec": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "override": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
