<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Deliberately overrides the private androidx.preference attr of the same name. -->
    <attr name="useSimpleSummaryProvider" format="boolean" tools:override="true" />
    <declare-styleable name="DialogSeekBarPreferenceAttrs">
        <attr name="min" format="integer" />
        <attr name="max" format="integer" />
        <attr name="seekBarIncrement" format="integer" />
        <attr name="android:defaultValue" format="integer" />
        <attr name="systemDefaultValueText" format="string" />
        <attr name="unit" format="string" />
        <attr name="useSimpleSummaryProvider" />
        <attr name="useMinAsDefault" format="boolean" />
    </declare-styleable>
</resources>
